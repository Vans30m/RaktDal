NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
FRONTEND_URL=http://localhost:5500

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
# JWT Secret
JWT_SECRET=your-jwt-secret-key-change-in-production
# Option A: Gmail SMTP Configuration (Sends to ANY email address directly from your Gmail)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-google-app-password

# Option B: EmailJS Configuration (Send transactional emails via EmailJS)
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key_or_user_id
EMAILJS_PRIVATE_KEY=your_private_key_or_access_token